# Modèle à copier en .env (jamais de vraie clé ici : ce fichier est publié)
LLM_PROVIDER=claude          # claude (outil de Kokoro) | gemini | openai | mock
ANTHROPIC_API_KEY=           # https://console.anthropic.com
CLASSIFY_MODEL=claude-opus-5-5
DRAFT_MODEL=claude-opus-5-5
EXTRACT_MODEL=claude-opus-5-5

# Comparaison coût / qualité avec d'autres fournisseurs
GEMINI_API_KEY=              # clé gratuite sur https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash            # rédaction des brouillons
GEMINI_FAST_MODEL=gemini-3.5-flash-lite  # classification et extraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

API_KEY=change-moi
POSTGRES_PASSWORD=agents
CORS_ORIGINS=http://localhost:4200

# Mesure de référence et hypothèses financières
BASELINE_MIN_EMAIL=6.0
BASELINE_MIN_DOCUMENT=9.0
HOURLY_COST_EUR=35
USD_TO_EUR=0.92
